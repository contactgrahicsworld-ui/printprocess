# Zero-dependency local run: `cp .env.development.local.example .env.development.local && npm run dev:local`
APP_URL=http://localhost:3000
APP_SECRET=local-dev-secret-0123456789-abcdefghijklmnop
DB_DRIVER=pglite
PGLITE_DATA_DIR=.pglite-dev
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
AUTH_DRIVER=dev
CRON_SECRET=local-cron-secret-0123
