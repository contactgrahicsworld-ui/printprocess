{
  "name": "mansa-print-agent",
  "version": "1.0.0",
  "description": "Windows Print Agent for Mansa Printer QR-to-print system",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "mansa-print-agent": "dist/agent.cjs" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run typecheck && npm run bundle",
    "build:exe": "npm run build && node scripts/build-sea.mjs",
    "start": "node dist/agent.cjs run"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
